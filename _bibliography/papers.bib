@inproceedings{bilal2026personality,
  title     = {Personality Trait Identification using Deep Learning and NLP: A Survey},
  author    = {Bilal, Muhammad and Abbas, Ghulam},
  booktitle = {Proceedings of the 2026 Global Conference on Wireless and Optical Technologies (GCWOT)},
  year      = {2026},
  publisher = {IEEE},
  abbr      = {GCWOT},
  selected  = {true},
  abstract  = {Personality detection from human text has gained research attention in recent years. Using deep learning and natural language processing, it has applications in career prediction and human-computer interaction. Our survey introduces a new taxonomy that divides deep learning approaches into six model groups: Transformer, RNN, CNN, Graph, Hybrid and Custom models. Based on our analysis from 22 studies, we give a comparison of features and dataset usage. Our review shows that transformer-based models achieve state-of-the-art accuracy but require high computational resources. The main challenges in personality detection have been limited datasets and high computational demands. This survey serves as a reference for researchers in choosing suitable personality prediction methodologies.}
}

@unpublished{bilal2026lightfusionnet,
  title    = {LightFusionNet: A Lightweight Multimodal Fusion Framework Combining Facial Dynamics and rPPG Signals for Depression Severity Detection},
  author   = {Bilal, Muhammad and Khan, Muhammad Turyalai and Shafait, Faisal and Khan, Hassan Aqeel},
  year     = {2026},
  note     = {Under review — AIiH 2026},
  abbr     = {AIiH},
  selected = {true},
  abstract = {Automated depression severity estimation from facial videos holds promise for scalable, contactless mental health monitoring. However, existing multimodal deep learning frameworks are computationally expensive, limiting their deployment in resource-constrained clinical and mobile settings. This paper proposes LightFusionNet, a lightweight multimodal framework that jointly leverages facial dynamics and remote photoplethysmography (rPPG) signals for depression severity estimation while adhering to Green AI principles. Visual features are extracted using a truncated MobileNetV3-Small backbone, and physiological biomarkers are derived via the Green Channel rPPG method, both designed for CPU-level inference. Evaluated on the AVEC2014 benchmark, LightFusionNet achieves an MAE/RMSE of 7.59/9.79 with only 0.46M total parameters, demonstrating that effective multimodal depression detection is achievable within strict efficiency constraints.}
}